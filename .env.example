# Neon Postgres — pooled connection string (set automatically via Vercel Marketplace)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Neon Postgres — direct connection string for migrations
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Clerk authentication — publishable key (server)
CLERK_PUBLISHABLE_KEY="pk_test_..."
# Clerk authentication — secret key
CLERK_SECRET_KEY="sk_test_..."
# Clerk authentication — publishable key (client mirror)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Comma-separated list of admin email addresses (lowercase)
ADMIN_EMAILS="admin@example.com"
# Random 32-byte hex string used by /api/cron/* endpoints
CRON_SECRET="0123456789abcdef0123456789abcdef"
# Contact email placed in scraper User-Agent header (mailto:)
USER_AGENT_CONTACT="scraper@example.com"
# Random 32-byte hex string used to salt IP hashes for submissions
SUBMISSION_IP_SALT="0123456789abcdef0123456789abcdef"

# Max concurrent ingestion tasks (1-8, default 4)
INGEST_CONCURRENCY=4
# Fuzzy-match threshold for auto-dedupe (0-1, default 0.92)
DEDUPE_AUTO_THRESHOLD=0.92
# Fuzzy-match threshold for review-queue dedupe (0-1, default 0.75)
DEDUPE_REVIEW_THRESHOLD=0.75

# Optional: Vercel Blob token for /api/cron/backup
# BLOB_READ_WRITE_TOKEN=""
# Optional: Neon API key for backup fallback
# NEON_API_KEY=""
# Optional: Cloudflare Turnstile keys (v1.1)
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Public site domain (used for feed URLs, sitemap, UIDs)
NEXT_PUBLIC_SITE_DOMAIN="http://localhost:3000"

# Enable debug-level logging (default false)
DEBUG=false

# Optional: iCal URLs for seed:sources script (omit to seed as inactive / URL pending)
# SEED_URL_UVM_EVENTS=""
# SEED_URL_CITY_BURLINGTON=""
# SEED_URL_LCC_VERMONT=""
