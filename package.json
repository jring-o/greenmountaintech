{
  "name": "vermont-events",
  "version": "0.1.0",
  "private": true,
  "description": "Vermont community events calendar",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm db:migrate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "prepare": "husky",
    "seed:fixtures": "tsx --import ./scripts/register-env.ts scripts/seed-fixtures.ts",
    "seed:sources": "tsx --import ./scripts/register-env.ts scripts/seed-sources.ts",
    "add:vcet": "tsx --import ./scripts/register-env.ts scripts/add-vcet.ts",
    "add:meetup": "tsx --import ./scripts/register-env.ts scripts/add-meetup.ts",
    "wipe:events": "tsx --import ./scripts/register-env.ts scripts/wipe-events.ts",
    "add:category:tech": "tsx --import ./scripts/register-env.ts scripts/add-category-tech.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@clerk/nextjs": "^7.2.5",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.3.3",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "fuzzball": "^2.2.3",
    "html-to-text": "^9.0.5",
    "lucide-react": "^1.8.0",
    "next": "^16.0.0",
    "node-ical": "^0.26.0",
    "p-limit": "^7.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.3",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "fast-xml-parser": "^5.7.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
